* text=auto
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.csv text eol=lf
*.cmd text eol=crlf
.gitattributes text eol=lf
.gitignore text eol=lf
# Conserva anche i sorgenti MQL5 originali UTF-16 senza conversioni.
*.mq5 -text
*.mqh -text
*.set -text
*.ex5 binary
*.xlsx binary
*.png binary
# L'intero archivio mine deve restare identico alle copie originali, inclusi i README.
mine/** -text
